# --- Filer PREPROD : variables d'environnement ---
# Copier en .env.preprod (non versionné) sur le Pi, dans le checkout
# /home/pi/sites/gotyeah-filer-preprod, puis :
#     docker compose -f docker-compose.preprod.yml up -d --build
#
# RÈGLE : aucun secret n'est partagé avec la production. SESSION_SECRET et le
# client OIDC sont propres à la preprod.

# Emails ayant un accès admin complet (mêmes admins qu'en prod, en général).
ADMIN_EMAILS=toi@example.com

# Secret de signature des cookies — DIFFÉRENT de la prod.
# Générer : openssl rand -base64 48
SESSION_SECRET=remplace-moi-par-une-chaine-longue-et-aleatoire

# Taille maximale d'un upload, en Mo.
MAX_UPLOAD_MB=1024

# URLs publiques de la preprod.
APP_URL=https://filer-preprod.gautierchuinard.com
FRONTEND_URL=https://filer-preprod.gautierchuinard.com

# --- OIDC (Keycloak, realm `gotyeah`) ---
# Client DÉDIÉ `filer-preprod` : ses redirect URIs pointent sur le domaine de
# preprod. Ne jamais réutiliser le client `filer` de la production.
OIDC_ISSUER=https://login.gautierchuinard.com/realms/gotyeah
OIDC_CLIENT_ID=filer-preprod
OIDC_CLIENT_SECRET=remplace-moi-par-le-secret-du-client-keycloak
OIDC_REDIRECT_URI=https://filer-preprod.gautierchuinard.com/api/auth/oidc/callback
OIDC_BUTTON_LABEL=Se connecter avec GotYeah

# Connexion historique (mot de passe) : `off` pour n'autoriser que l'OIDC.
LEGACY_LOGIN=off
