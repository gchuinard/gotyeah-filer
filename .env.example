# --- Filer : variables d'environnement ---
# Copier ce fichier en .env (non versionné) et adapter les valeurs.

# Emails ayant un accès admin complet (séparés par des virgules).
# Comparaison insensible à la casse / aux espaces.
ADMIN_EMAILS=toi@example.com,autre-admin@example.com

# Secret de signature des cookies de session (long et aléatoire).
# Générer : openssl rand -base64 48
SESSION_SECRET=remplace-moi-par-une-chaine-longue-et-aleatoire

# Taille maximale d'un upload, en Mo (défaut applicatif : 1024).
MAX_UPLOAD_MB=1024

# URL publique de l'application (utilisée pour construire les liens de partage).
APP_URL=https://filer.gautierchuinard.com

# (Optionnel) Répertoire des données : fichiers uploadés + base SQLite.
# Défaut = /data (volume Docker). À ne définir qu'en dev local.
# DATA_DIR=/data

# --- OIDC (Keycloak, realm `gotyeah`) — bouton « Se connecter avec GotYeah » ---
# Laisser vide pour désactiver l'OIDC (les 4 variables sont requises ensemble).
# L'origine de OIDC_REDIRECT_URI doit être IDENTIQUE à APP_URL : l'app refuse de
# lancer le SSO sinon (sans ce contrôle, l'aller-retour déposerait l'utilisateur
# sur une autre pile). Chaque environnement a son propre client Keycloak.
OIDC_ISSUER=https://login.gautierchuinard.com/realms/gotyeah
OIDC_CLIENT_ID=filer
OIDC_CLIENT_SECRET=remplace-moi-par-le-secret-du-client-keycloak
OIDC_REDIRECT_URI=https://filer.gautierchuinard.com/api/auth/oidc/callback
OIDC_BUTTON_LABEL=Se connecter avec GotYeah

# Connexion historique par email : `off` pour n'autoriser que l'OIDC.
LEGACY_LOGIN=off
